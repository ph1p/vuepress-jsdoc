{
  "name": "vuepress-jsdoc-example",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "docs": "vuepress-jsdoc --jsDocConfigPath=jsdoc.json --source=./src --dist=./documentation --title=API --exclude=class.js --partials=./partials/*.hbs --readme=./README.md",
    "docs:dev": "pnpm run docs --watch",
    "dev": "pnpm run docs && vuepress dev documentation",
    "build:local": "pnpm run docs && vuepress build documentation",
    "build": "vuepress build documentation"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/theme-default": "2.0.0-rc.137",
    "jsdoc-babel": "^0.5.0",
    "sass-embedded": "^1.108.1",
    "typescript": "^7.0.2",
    "vue": "^3.5.45",
    "vuepress": "2.0.0-rc.31",
    "vuepress-jsdoc": "workspace:*"
  },
  "private": true,
  "type": "module"
}

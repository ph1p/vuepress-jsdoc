{
  "name": "vuepress-jsdoc",
  "version": "6.1.0",
  "description": "Generate jsdoc markdown files for vuepress",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test-coverage": "vitest run --coverage",
    "test-watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "dev": "tsc -w",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "pnpm run build",
    "prepare": "husky",
    "version": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s && git add CHANGELOG.md",
    "docs": "./bin/vuepress-jsdoc.js --source=./src --partials=./example/partials/*.hbs --readme=./README.md --format=vitepress --exclude=\"**/__tests__/**\"",
    "docs:dev": "pnpm run build && pnpm run docs && vitepress dev documentation",
    "docs:build": "pnpm run build && pnpm run docs && vitepress build documentation"
  },
  "keywords": [
    "jsdoc",
    "static",
    "documentation",
    "vue",
    "vuepress"
  ],
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "license": "MIT",
  "author": "Philip Stapelfeldt <me@ph1p.dev>",
  "repository": {
    "url": "https://github.com/ph1p/vuepress-jsdoc.git",
    "type": "git"
  },
  "prettier": {
    "useTabs": false,
    "singleQuote": true,
    "tabWidth": 2,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "files": [
    "bin",
    "dist",
    "template"
  ],
  "bin": {
    "vuepress-jsdoc": "bin/vuepress-jsdoc.js"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "commander": "^15.1.0",
    "del": "^9.0.1",
    "front-matter": "^4.0.2",
    "jsdoc-to-markdown": "^9.1.3",
    "kleur": "^4.1.5",
    "micromatch": "^4.0.8",
    "vue-docgen-cli": "^4.79.0"
  },
  "peerDependencies": {
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdoc-to-markdown": "^7.0.6",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "memfs": "^4.80.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.json": [
      "prettier --write"
    ]
  }
}
